# Local synthetic demonstration. Never use demo mode for a public deployment.
CIVIC_DEMO_MODE=true
DATABASE_URL=sqlite:///./data/civicsignal.db
# Local default; use database on Render Free so photos survive restarts.
CIVIC_EVIDENCE_STORAGE=filesystem
# Used by the production readiness checker; set your real HTTPS address.
# CIVIC_PUBLIC_ORIGIN=https://your-service.onrender.com
# See services/api/database.py and security.py for enforced configuration.
# PostgreSQL Docker example:
# DATABASE_URL=postgresql+psycopg://civic:civic-local@db:5432/civic
# Optional email delivery. Set these in the worker's environment; scripts/run.py
# does not load this file automatically. Keep real credentials out of Git.
# CIVIC_SMTP_HOST=smtp.example.invalid
# CIVIC_SMTP_PORT=587
# CIVIC_SMTP_FROM=notifications@example.invalid
# CIVIC_SMTP_USER=
# CIVIC_SMTP_PASSWORD=
